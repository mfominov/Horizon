{
  "ai": {
    "provider": "openai",
    "model": "${OPENROUTER_MODEL}",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0.2,
    "max_tokens": 4096,
    "throttle_sec": 0.5,
    "languages": ["ru"],
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "work-radar",
    "profile_settings": {
      "work-radar": {
        "threshold": 0.0,
        "topic_dedup": false
      },
      "personal-radar": {
        "threshold": 0.0,
        "topic_dedup": false
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "deckhouse",
        "repo": "deckhouse",
        "enabled": true,
        "profile": "work-radar"
      },
      {
        "type": "repo_releases",
        "owner": "deckhouse",
        "repo": "deckhouse",
        "enabled": true,
        "profile": "personal-radar"
      },
      {
        "type": "repo_releases",
        "owner": "kubernetes",
        "repo": "kubernetes",
        "enabled": true,
        "profile": "work-radar"
      },
      {
        "type": "repo_releases",
        "owner": "kubernetes",
        "repo": "kubernetes",
        "enabled": true,
        "profile": "personal-radar"
      },
      {
        "type": "repo_releases",
        "owner": "netbirdio",
        "repo": "netbird",
        "enabled": true,
        "profile": "work-radar"
      },
      {
        "type": "repo_releases",
        "owner": "netbirdio",
        "repo": "netbird",
        "enabled": true,
        "profile": "personal-radar"
      },
      {
        "type": "repo_releases",
        "owner": "wg-easy",
        "repo": "wg-easy",
        "enabled": true,
        "profile": "work-radar"
      },
      {
        "type": "repo_releases",
        "owner": "wg-easy",
        "repo": "wg-easy",
        "enabled": true,
        "profile": "personal-radar"
      },
      {
        "type": "personalized_discovery",
        "enabled": true,
        "token_env": "GITHUB_TOKEN",
        "seed_sources": ["watched", "starred"],
        "max_watched_seeds": 100,
        "max_starred_seeds": 200,
        "active_within_days": 180,
        "max_search_queries": 6,
        "max_candidates": 20,
        "min_stars": 50,
        "exclude_forks": true,
        "exclude_archived": true,
        "fan_out_profiles": true,
        "category": "github-discovery",
        "profile": ["work-radar", "personal-radar"]
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50,
      "category": "engineering-news",
      "profile": ["work-radar", "personal-radar"]
    },
    "rss": [
      {
        "name": "Kubernetes Blog — Work",
        "url": "https://kubernetes.io/feed.xml",
        "enabled": true,
        "category": "platform-engineering",
        "profile": "work-radar"
      },
      {
        "name": "Kubernetes Blog — Personal",
        "url": "https://kubernetes.io/feed.xml",
        "enabled": true,
        "category": "platform-engineering",
        "profile": "personal-radar"
      },
      {
        "name": "selfh.st — Work",
        "url": "https://selfh.st/rss/",
        "enabled": true,
        "category": "self-hosting",
        "profile": "work-radar"
      },
      {
        "name": "selfh.st — Personal",
        "url": "https://selfh.st/rss/",
        "enabled": true,
        "category": "self-hosting",
        "profile": "personal-radar"
      },
      {
        "name": "CNCF Blog",
        "url": "https://www.cncf.io/feed/",
        "enabled": true,
        "category": "cloud-native",
        "profile": ["work-radar", "personal-radar"]
      },
      {
        "name": "Grafana Labs Blog",
        "url": "https://grafana.com/blog/index.xml",
        "enabled": true,
        "category": "observability",
        "profile": ["work-radar", "personal-radar"]
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "infrastructure",
        "profile": ["work-radar", "personal-radar"]
      }
    ],
    "reddit": {
      "enabled": true,
      "request_delay_sec": 5.0,
      "subreddits": [
        {
          "subreddit": "devops",
          "sort": "new",
          "fetch_limit": 5,
          "min_score": 0,
          "category": "devops",
          "profile": ["work-radar", "personal-radar"]
        },
        {
          "subreddit": "selfhosted",
          "sort": "new",
          "fetch_limit": 5,
          "min_score": 0,
          "category": "self-hosting",
          "profile": ["work-radar", "personal-radar"]
        }
      ],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "devops_fm",
          "enabled": true,
          "fetch_limit": 4,
          "category": "devops",
          "profile": "work-radar"
        },
        {
          "channel": "devops_fm",
          "enabled": true,
          "fetch_limit": 4,
          "category": "devops",
          "profile": "personal-radar"
        }
      ]
    },
    "telegram_user": {
      "enabled": false,
      "api_id_env": "TELEGRAM_API_ID",
      "api_hash_env": "TELEGRAM_API_HASH",
      "session_path": "data/telegram_user.session",
      "channels": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Go", "Python", "TypeScript"],
      "keywords": ["platform", "kubernetes", "observability", "sre", "self-hosted", "devops"],
      "min_stars": 10,
      "max_items": 20,
      "category": "oss-trending",
      "profile": ["work-radar", "personal-radar"]
    },
    "google_news": {
      "enabled": true,
      "query": "(\"platform engineering\" OR SRE OR Kubernetes OR \"self-hosted\")",
      "language": "en",
      "country": "US",
      "max_results": 25,
      "category": "industry-news",
      "profile": ["work-radar", "personal-radar"]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "group_by": "profile",
    "profile_order": ["work-radar", "personal-radar"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["ru"],
    "request_body": {
      "title": "#{message_title}",
      "text": "#{summary}",
      "selected": "#{important_items}",
      "total": "#{all_items}"
    },
    "headers": "Content-Type: application/json"
  }
}
